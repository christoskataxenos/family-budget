# Μυστικά κλειδιά και ρυθμίσεις περιβάλλοντος για την εφαρμογή Family Budget
SECRET_KEY="change_this_to_a_super_secret_random_string_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# Ρυθμίσεις Βάσης Δεδομένων (SQLite)
DATABASE_URL="sqlite+aiosqlite:///./data/budget.db"

# Ρυθμίσεις Αρχικού Διαχειριστή (Seed Admin)
FIRST_ADMIN_EMAIL="admin@family.local"
FIRST_ADMIN_PASSWORD="AdminPassword123!"
FIRST_ADMIN_NAME="Family Admin"

# Προσαρμοσμένες Θύρες Εφαρμογής (Host Ports)
# Αλλάξτε αυτές τις θύρες αν έχετε άλλες εφαρμογές στη θύρα 8000 ή 80
BACKEND_PORT=8050
PROXY_PORT=8080
